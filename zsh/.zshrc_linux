
alias proxy='export http_proxy=http://127.0.0.1:7897; export https_proxy=http://127.0.0.1:7897; export all_proxy=socks5://127.0.0.1:7897; echo "代理已开启 🚀"'

alias mount='rclone mount gdrive: ~/gdrive --vfs-cache-mode writes --daemon && echo "Google Drive 已挂载 📂"'
alias cleancache='sudo paccache -r && sudo paccache -ruk0 && rm -rf ~/.cache/paru/clone/* ~/.cache/paru/diff/*'

alias vivado='source /tools/Xilinx/Vivado/2023.2/settings64.sh && vivado'

export CHIPLAB_HOME="$HOME/chipLab"
export PATH=$PATH:/opt/loongarch32r-toolchain/bin